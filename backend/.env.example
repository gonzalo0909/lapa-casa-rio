# Lapa Casa Hostel - Channel Manager
# Copiar a .env y completar con los valores reales.
# ventana4: lista completa, generada a partir de cada process.env.* que el
# codigo del backend efectivamente lee (grep -rhoE "process\.env\.[A-Z_]+" src).

# --- Servidor ---
NODE_ENV=development
PORT=3001
APP_URL=https://lapacasario.com
API_VERSION=v1
FRONTEND_URL=https://lapacasario.com
LOG_LEVEL=debug

# --- Postgres (Supabase en produccion; local/Docker en desarrollo) ---
DATABASE_URL=postgresql://lapa_dev:lapa_dev_pw@localhost:5432/lapa_casa_hostel
DB_MAX_CONNECTIONS=10
DB_CONNECTION_TIMEOUT=5000

# Pool separado y chico para Prisma (dominio admin/config -- ver
# prisma/schema.prisma y src/config/prisma.ts). DB_MAX_CONNECTIONS +
# PRISMA_MAX_CONNECTIONS no debe superar el limite de conexiones del plan
# de Supabase.
PRISMA_MAX_CONNECTIONS=5

# CA real de Supabase -- ya NO hace falta cargarla acá: no es un secreto
# (es la CA pública de Supabase) y viene commiteada como código en
# src/config/supabase-ca.ts, usada automáticamente por src/config/database.ts.
# Esta variable queda solo como override opcional (ej. si Supabase rota la
# CA antes de actualizar el archivo del repo) -- en PEM, con los \n literales.
DATABASE_CA_CERT=

# --- Redis (cache + rate limiting). Sin esta variable, el sistema cae a un
# fallback en memoria por proceso -- funciona, pero no comparte estado entre
# instancias (ver src/cache/redis-client.ts). ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d
ENCRYPTION_KEY=dev-encryption-key-32-chars-long!

# --- CORS / rate limiting ---
CORS_ORIGINS=*
CORS_CREDENTIALS=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Pagos: Stripe. Sin STRIPE_SECRET_KEY, los pagos Stripe quedan
# deshabilitados (ver src/lib/payments/stripe-handler.ts). ---
STRIPE_SECRET_KEY=<tu-stripe-secret-key-de-test-o-produccion>
STRIPE_WEBHOOK_SECRET=<tu-stripe-webhook-signing-secret>

# --- Pagos: MercadoPago. Sin MP_ACCESS_TOKEN, los pagos MercadoPago quedan
# deshabilitados (ver src/lib/payments/mercado-pago-handler.ts). ---
MP_ACCESS_TOKEN=<tu-mercadopago-access-token>

# --- Email (Resend) ---
RESEND_API_KEY=<tu-resend-api-key>
FROM_EMAIL=reservas@lapacasario.com
EMAIL_FROM=reservas@lapacasario.com
EMAIL_FROM_NAME=Lapa Casa Hostel
ADMIN_EMAIL=admin@lapacasario.com

# --- Login admin (ventana4, bloque 2) — admin único, sin roles multiples.
# ADMIN_PASSWORD_HASH es un hash bcrypt, nunca la contraseña en texto plano.
# Generarlo localmente:
#   node -e "require('bcryptjs').hash('tu-contraseña', 12).then(console.log)"
ADMIN_PASSWORD_HASH=

# --- WhatsApp (opcional, desactivado si WHATSAPP_ENABLED != true) ---
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=

# --- Webhooks de reservas OTA (ventana5). Solo Booking.com y Expedia
# tienen webhook -- Airbnb/Hostelworld son iCal-only (ver
# src/config/channels.ts, src/routes/webhooks/ota.routes.ts). Sin el
# *_WEBHOOK_SECRET del canal, ese webhook rechaza todo con 401 (nunca
# "acepta todo" para un endpoint que crea reservas reales). *_WEBHOOK_IPS
# es opcional, coma-separado; sin configurar, no se filtra por IP.
BOOKING_WEBHOOK_SECRET=
BOOKING_WEBHOOK_API_KEY=
BOOKING_WEBHOOK_IPS=
EXPEDIA_WEBHOOK_SECRET=
EXPEDIA_WEBHOOK_API_KEY=
EXPEDIA_WEBHOOK_IPS=

# Los feeds iCal a importar (Airbnb/Hostelworld, y respaldo de
# disponibilidad para Booking/Expedia) se configuran en runtime desde el
# panel admin (POST /api/v1/ical/import/config) -- no requieren variables
# de entorno, quedan guardados en system_config (ver services/ical-service.ts).

# --- Google Sheets (ventana4, bloque 2). Exportacion de solo lectura hacia
# afuera -- la DB es la unica fuente de verdad, la hoja es un espejo de
# reporting. Sin estas 3 variables, la exportacion queda deshabilitada (se
# loguea y se omite, no rompe nada). Pasos para configurarlas:
#   1. https://console.cloud.google.com/ -> crear proyecto (o usar uno existente)
#   2. Habilitar "Google Sheets API" en ese proyecto
#   3. IAM & Admin -> Service Accounts -> crear una, generar una key JSON
#   4. De ese JSON: `client_email` -> GOOGLE_SERVICE_ACCOUNT_EMAIL,
#      `private_key` -> GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY (con los \n literales)
#   5. Crear el spreadsheet en Google Sheets, compartirlo con ese
#      client_email como Editor, copiar el ID de la URL (entre /d/ y /edit)
#      -> GOOGLE_SHEETS_SPREADSHEET_ID
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Link de reseña de Google Maps para el email automático que se manda
# 24-48h después del check-out (idea #47, roadmap.html -- ya estaba
# implementado, solo faltaba documentar esta variable). Sin configurar,
# usa un link de ejemplo que no es real (ver sendReviewRequest en
# email-service.ts). Para conseguir el real: buscar el negocio en Google
# Maps -> "Pedir reseñas" -> copiar el link corto que da ahí.
GOOGLE_REVIEW_URL=
# Debe coincidir EXACTO con el nombre real de la pestaña en tu Google
# Sheet (mirá abajo a la izquierda en sheets.google.com). El default de
# Google en cuentas en español es "Hoja 1", no "Sheet1".
GOOGLE_SHEETS_SHEET_NAME=Hoja 1

# --- Sentry (monitoreo de errores) ---
# Obtener desde sentry.io → Proyecto lapa-backend → Settings → Client Keys (DSN)
SENTRY_DSN=
