{
  "name": "lapa-casa-hostel-backend",
  "version": "1.0.0",
  "description": "Backend API for Lapa Casa Hostel",
  "main": "dist/server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "worker:dev": "tsx watch src/workers/index.ts",
    "build": "prisma generate && tsc && tsc-alias && npm run copy-assets",
    "type-check": "tsc --noEmit",
    "copy-assets": "mkdir -p dist/templates/emails dist/admin dist/public && cp -r src/templates/emails/. dist/templates/emails/ && cp -r src/admin/. dist/admin/ && cp -r src/public/. dist/public/",
    "migrate": "node database/scripts/migrate.js",
    "seed": "node database/scripts/seed.js",
    "start": "npm run migrate; npm run seed; node dist/server.js",
    "worker": "node dist/workers/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "hostel",
    "booking",
    "api"
  ],
  "author": "Lapa Casa Hostel",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/node": "^10.73.0",
    "@types/multer": "^2.2.0",
    "@types/pg": "^8.20.3",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.0.7",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "google-auth-library": "^10.5.0",
    "googleapis": "^178.0.0",
    "helmet": "^7.1.0",
    "ical-generator": "^7.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "node-ical": "^0.27.1",
    "nodemailer": "^9.0.5",
    "otplib": "^13.5.0",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "resend": "^4.0.1",
    "stripe": "^14.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "prisma": "7.10.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  }
}
