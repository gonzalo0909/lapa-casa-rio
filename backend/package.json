{
  "name": "lapa-casa-hostel-backend",
  "version": "1.0.0",
  "description": "Backend API for Lapa Casa Hostel",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker:dev": "tsx watch src/workers/index.ts",
    "build": "tsc || true; tsc-alias && npm run copy-assets",
    "copy-assets": "mkdir -p dist/templates/emails dist/admin && cp -r src/templates/emails/. dist/templates/emails/ && cp -r src/admin/. dist/admin/",
    "migrate": "node database/scripts/migrate.js",
    "start": "npm run migrate && node dist/server.js",
    "worker": "node dist/workers/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "keywords": [
    "hostel",
    "booking",
    "api"
  ],
  "author": "Lapa Casa Hostel",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/pg": "^8.20.3",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.0.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "google-auth-library": "^9.15.0",
    "googleapis": "^144.0.0",
    "helmet": "^7.1.0",
    "ical-generator": "^7.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^2.0.6",
    "node-ical": "^0.18.0",
    "pg": "^8.22.0",
    "resend": "^4.0.1",
    "stripe": "^14.0.0",
    "uuid": "^11.0.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "ts-jest": "^29.4.12",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
