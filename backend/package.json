{
  "name": "lapa-casa-hostel-backend",
  "version": "1.0.0",
  "description": "Backend API for Lapa Casa Hostel",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "db:migrate": "node database/scripts/migrate.js",
    "db:seed": "node database/scripts/seed.js",
    "db:reset": "node database/scripts/reset.js",
    "db:test": "node database/tests/test-scenarios.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "keywords": [
    "hostel",
    "booking",
    "api"
  ],
  "author": "Lapa Casa Hostel",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "google-auth-library": "^9.15.0",
    "googleapis": "^144.0.0",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "ical-generator": "^7.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^2.2.0",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "node-ical": "^0.18.0",
    "pg": "^8.22.0",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.7.0",
    "resend": "^4.0.1",
    "stripe": "^17.5.0",
    "uuid": "^11.0.4",
    "winston": "^3.17.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
